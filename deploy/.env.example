# Server
# For local Windows use, copy this file to local/.env. The legacy root .env is
# still supported and remains useful for Docker Compose variable expansion.
# Local installations already default to 127.0.0.1:8765 and local/data/.
# Docker Compose supplies its own 0.0.0.0 and /data overrides.
PAPERFIELD_AUTO_REFRESH=1
# For a remotely shared Compose deployment, set these two browser-facing URLs
# to the public Paperfield origin. Local defaults keep all browser traffic on 8765.
RESEARCH_ATLAS_PAPERFIELD_URL=http://127.0.0.1:8765/
RESEARCH_ATLAS_FLOWLOOM_URL=http://127.0.0.1:8765/flowloom/
# Only needed when Flowloom runs as a separate local Vite/preview origin and
# must fetch an authenticated Paperfield PDF for vector extraction.
PAPERFIELD_FLOWLOOM_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://[::1]:5173,http://127.0.0.1:4178,http://localhost:4178,http://[::1]:4178

# Optional Research Atlas companion. Defaults match the local Paperfield and
# Flowloom services; Atlas keeps its own database and never reads Paperfield's.
RESEARCH_ATLAS_HOST=127.0.0.1
RESEARCH_ATLAS_PORT=8795
RESEARCH_ATLAS_DB_PATH=local/atlas/atlas.db
RESEARCH_ATLAS_PAPERFIELD_URL=http://127.0.0.1:8765/
RESEARCH_ATLAS_FLOWLOOM_URL=http://127.0.0.1:8765/flowloom/
PAPERFIELD_ATLAS_INTERNAL_URL=http://127.0.0.1:8795
# Optional shared secret for the loopback-only Paperfield metadata change feed.
# Set the same random value on both sides when Paperfield authentication is enabled.
PAPERFIELD_ATLAS_SYNC_TOKEN=
RESEARCH_ATLAS_PAPERFIELD_SYNC_TOKEN=
# Shared secret used by the mounted Paperfield -> Atlas reverse proxy.
# Keep the value identical on both services and use a high-entropy random value.
PAPERFIELD_ATLAS_PROXY_TOKEN=
RESEARCH_ATLAS_PAPERFIELD_PROXY_TOKEN=
# Required only for a separate analysis worker. Keep this private and long.
RESEARCH_ATLAS_WORKER_TOKEN=
# The Atlas worker uses only these dedicated model settings. It never falls
# back to Paperfield, generic OPENAI_*, Codex, or CC Switch credentials.
RESEARCH_ATLAS_URL=http://127.0.0.1:8795
RESEARCH_ATLAS_WORKER_ID=local-workstation
RESEARCH_ATLAS_OPENAI_API_KEY=
RESEARCH_ATLAS_OPENAI_BASE_URL=https://api.openai.com/v1
RESEARCH_ATLAS_OPENAI_MODEL=
RESEARCH_ATLAS_OPENAI_WIRE_API=responses
RESEARCH_ATLAS_OPENAI_REASONING_EFFORT=high
RESEARCH_ATLAS_MATERIAL_DIR=local/atlas/materials
RESEARCH_ATLAS_WORKER_POLL_SECONDS=8
RESEARCH_ATLAS_WORKER_LEASE_SECONDS=900
RESEARCH_ATLAS_PDF_MAX_MB=64
RESEARCH_ATLAS_DOWNLOAD_TIMEOUT_SECONDS=90
RESEARCH_ATLAS_MODEL_TIMEOUT_SECONDS=240
RESEARCH_ATLAS_MAX_SOURCE_CHARS=180000
RESEARCH_ATLAS_MAX_OUTPUT_TOKENS=12000

# Public-source scanner. It reads arXiv plus fixed, first-party RSS/Atom feeds
# and never calls a model. Candidate papers, official updates, terminology,
# and reviewed signals remain separate.
RESEARCH_ATLAS_ARXIV_DOMAINS=embodied,llm
RESEARCH_ATLAS_SCAN_DAYS_BACK=14
RESEARCH_ATLAS_ARXIV_MAX_RESULTS_PER_DOMAIN=25
RESEARCH_ATLAS_OFFICIAL_FEEDS=all
RESEARCH_ATLAS_OFFICIAL_MAX_RESULTS_PER_SOURCE=12
RESEARCH_ATLAS_SOURCE_TIMEOUT_SECONDS=45
RESEARCH_ATLAS_SCAN_INTERVAL_SECONDS=86400

# Optional reserved ngrok domain for a stable beta-sharing address.
# Reserve it at https://dashboard.ngrok.com/domains before setting it here.
PAPERFIELD_NGROK_URL=

# Optional Paperfield-only AI override.
# Leave blank on a local Windows installation to use the active CC Switch provider.
PAPERFIELD_OPENAI_API_KEY=
PAPERFIELD_OPENAI_BASE_URL=https://api.openai.com/v1
PAPERFIELD_OPENAI_MODEL=gpt-5-mini
# Use responses or chat_completions when an explicit Paperfield API override is set.
PAPERFIELD_OPENAI_WIRE_API=responses

# Optional LibreTranslate-compatible service. When blank, Paperfield uses the
# browser's local Translator API first and a no-key Google endpoint as fallback.
PAPERFIELD_TRANSLATE_ENDPOINT=
PAPERFIELD_TRANSLATE_API_KEY=

# Optional GitHub token. Anonymous project discovery also works.
GITHUB_TOKEN=

# Optional unstable DBLP supplement.
PAPERFIELD_ENABLE_DBLP=0

# Optional S3-compatible cloud archive. Supports Cloudflare R2, Backblaze B2,
# AWS S3, and other providers exposing the S3 API.
PAPERFIELD_S3_PROVIDER=
PAPERFIELD_S3_ENDPOINT=
PAPERFIELD_S3_REGION=auto
PAPERFIELD_S3_BUCKET=
PAPERFIELD_S3_ACCESS_KEY_ID=
PAPERFIELD_S3_SECRET_ACCESS_KEY=

# Local PDF cache size. Cloud PDFs are downloaded on demand and old cached
# files are removed when this limit is exceeded.
PAPERFIELD_LOCAL_CACHE_MAX_MB=2048
# Cloudflare dashboard billing cycle start day (1-28).
PAPERFIELD_R2_BILLING_CYCLE_DAY=1

# Public GitHub source cache safety limits. Downloaded repository code is never executed.
PAPERFIELD_PROJECT_ZIP_MAX_MB=120
PAPERFIELD_PROJECT_TEXT_MAX_MB=200
# Archive downloads move to a background job. When a ZIP is too large or slow,
# Paperfield falls back to a bounded curated source snapshot.
PAPERFIELD_PROJECT_ARCHIVE_TIMEOUT_SECONDS=40
PAPERFIELD_PROJECT_ARCHIVE_REPOSITORY_MAX_MB=96
PAPERFIELD_PROJECT_SELECTIVE_MAX_FILES=180
PAPERFIELD_PROJECT_SELECTIVE_TEXT_MAX_MB=24
PAPERFIELD_PROJECT_SELECTIVE_WORKERS=6
PAPERFIELD_PROJECT_SELECTIVE_FILE_TIMEOUT_SECONDS=12
