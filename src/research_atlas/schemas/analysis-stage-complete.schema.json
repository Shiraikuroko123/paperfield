{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperfield.local/schemas/analysis-stage-complete.schema.json",
  "title": "Research Atlas analysis stage completion",
  "type": "object",
  "required": ["sourceBasis", "content"],
  "additionalProperties": false,
  "properties": {
    "sourceBasis": {
      "enum": ["metadata", "abstract", "fulltext", "supplementary", "code", "mixed"]
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "model": {
      "type": "string",
      "maxLength": 240
    },
    "promptVersion": {
      "type": "string",
      "maxLength": 120
    },
    "content": {
      "type": "object",
      "required": ["sections"],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 12000
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 60,
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "sourceBasis": {
            "enum": ["fulltext", "supplementary", "mixed"]
          }
        }
      },
      "then": {
        "required": ["sourceSha256"]
      }
    }
  ],
  "$defs": {
    "section": {
      "type": "object",
      "required": ["body", "sourceKind"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30000
        },
        "sourceKind": {
          "enum": [
            "paper_claim",
            "platform_derivation",
            "editorial_judgment",
            "insufficient_information"
          ]
        },
        "confidence": {
          "enum": ["high", "medium", "low", "unknown"]
        },
        "evidence": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sourceKind": {
                "enum": ["paper_claim", "platform_derivation"]
              }
            }
          },
          "then": {
            "required": ["evidence"],
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 300
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "section": {
          "type": "string",
          "maxLength": 300
        },
        "figure": {
          "type": "string",
          "maxLength": 120
        },
        "table": {
          "type": "string",
          "maxLength": 120
        },
        "quote": {
          "type": "string",
          "maxLength": 4000
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "direction": {
          "enum": ["supports", "contradicts", "qualifies"]
        }
      },
      "anyOf": [
        { "required": ["page"] },
        { "required": ["section"] },
        { "required": ["figure"] },
        { "required": ["table"] },
        { "required": ["quote"] },
        { "required": ["sourceUrl"] }
      ]
    }
  }
}
